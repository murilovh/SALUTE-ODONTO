---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import Calm from '../components/Calm.astro';
import Treatments from '../components/Treatments.astro';
import Dentist from '../components/Dentist.astro';
import Space from '../components/Space.astro';
import FirstVisit from '../components/FirstVisit.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsappFab from '../components/WhatsappFab.astro';
---

<Base
  title="Dentista em Ibiraquera e Praia do Rosa | Salute Odontologia"
  description="Clínica odontológica em Ibiraquera, Imbituba (SC), pertinho da Praia do Rosa. Clínica geral, estética e reabilitação com a Dra. Maria Eduarda Patussi. Agende pelo WhatsApp."
>
  <Nav />
  <main id="conteudo">
    <Hero />
    <SocialProof />
    <Calm />
    <Treatments />
    <Dentist />
    <Space />
    <FirstVisit />
    <Testimonials />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <WhatsappFab />
</Base>

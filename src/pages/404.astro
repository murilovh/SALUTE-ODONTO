---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="Página não encontrada | Salute Odontologia" description="Esta página não existe. Volte para o início do site da Salute Odontologia.">
  <main id="conteudo" class="container-page flex min-h-[100dvh] flex-col justify-center py-24">
    <a href="/" class="flex items-baseline gap-2 text-sea-800">
      <span class="font-display text-[1.75rem] leading-none">Salute</span>
      <span class="text-xs font-medium tracking-[0.12em] text-ink-600">odontologia</span>
    </a>
    <h1 class="mt-12 max-w-[16ch] text-display-lg">Essa página foi dar um mergulho.</h1>
    <p class="mt-6 max-w-prose text-lead text-ink-600">O endereço não existe ou mudou. Volte para o início ou fale com a gente pelo WhatsApp.</p>
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a href="/" class="btn-primary">Voltar ao início</a>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="link-arrow">
        Agendar avaliação
        <Icon name="ArrowUpRight" size={18} />
      </a>
    </div>
  </main>
</Base>

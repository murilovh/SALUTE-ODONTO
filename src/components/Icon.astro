---
// Renderiza ícones do Lucide como SVG estático no build (zero JS no cliente).
import * as lucide from 'lucide';

interface Props {
  name: keyof typeof lucide;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className, strokeWidth = 1.75 } = Astro.props;
const node = lucide[name] as unknown as [string, Record<string, string>][];
if (!Array.isArray(node)) throw new Error(`Ícone Lucide não encontrado: ${String(name)}`);

const inner = node
  .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`)
  .join('');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={inner}
/>

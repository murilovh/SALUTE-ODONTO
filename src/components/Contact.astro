---
import Icon from './Icon.astro';
import { site } from '../data/site';

const { street, neighborhood, city, state, zip } = site.address;
---

<section id="contato" class="py-section">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 data-split class="text-display-lg">Venha nos visitar</h2>

      <dl class="mt-10 grid gap-8">
        <div data-reveal class="grid grid-cols-[auto_1fr] gap-4">
          <dt class="contents"><Icon name="MapPin" size={22} class="row-span-2 mt-0.5 text-sea-700" /><span class="text-sm text-ink-600">Endereço</span></dt>
          <dd class="col-start-2 -mt-3">
              <address class="not-italic">
                {street}, [CONFIRMAR número]<br />
                {neighborhood}, {city} / {state}<br />
                {zip}
              </address>
            </dd>
        </div>
        <div data-reveal class="grid grid-cols-[auto_1fr] gap-4">
          <dt class="contents"><Icon name="Clock" size={22} class="row-span-2 mt-0.5 text-sea-700" /><span class="text-sm text-ink-600">Horário</span></dt>
          <dd class="col-start-2 -mt-3">{site.hours}</dd>
        </div>
        <div data-reveal class="grid grid-cols-[auto_1fr] gap-4">
          <dt class="contents"><Icon name="Phone" size={22} class="row-span-2 mt-0.5 text-sea-700" /><span class="text-sm text-ink-600">WhatsApp</span></dt>
          <dd class="col-start-2 -mt-3"><a href={site.whatsapp} target="_blank" rel="noopener" class="hover:text-sea-800">{site.phoneDisplay}</a></dd>
        </div>
      </dl>

      <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn-primary">
          <Icon name="MessageCircle" size={20} />
          Agendar avaliação
        </a>
        <a href={site.maps} target="_blank" rel="noopener" class="link-arrow">
          Como chegar
          <Icon name="ArrowUpRight" size={18} />
        </a>
      </div>
    </div>

    <div data-reveal class="lg:col-span-7">
      <div class="aspect-[4/3] overflow-hidden rounded-soft bg-sand-200 lg:aspect-auto lg:h-full lg:min-h-[28rem]">
        <iframe
          title="Mapa com a localização da Salute Odontologia em Ibiraquera, Imbituba"
          src={site.mapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="size-full border-0 grayscale-[35%]"></iframe>
      </div>
    </div>
  </div>
</section>

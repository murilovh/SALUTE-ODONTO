---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-sea-900 text-sand-50">
  <div class="container-page py-section">
    <h2 data-split class="max-w-[16ch] text-display-xl !text-sand-50">Seu sorriso merece esse cuidado.</h2>
    <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener"
        class="btn bg-sand-50 text-sea-900 hover:bg-sea-100"
      >
        <Icon name="MessageCircle" size={20} />
        Agendar avaliação
      </a>
      <a
        href={site.instagram}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 font-medium text-sand-50 underline decoration-sand-50/40 decoration-2 underline-offset-[6px] hover:decoration-sand-50"
      >
        Seguir no Instagram
        <Icon name="ArrowUpRight" size={18} />
      </a>
    </div>
  </div>

  <div class="border-t border-sand-50/15">
    <div class="container-page grid gap-8 py-10 pb-28 text-sm text-sand-100 md:grid-cols-3 md:pb-10">
      <div>
        <p class="font-display text-2xl text-sand-50">Salute</p>
        <p class="mt-2 max-w-[30ch]">{site.slogan}</p>
      </div>
      <div class="flex flex-col gap-1.5">
        <p>{site.address.street}, {site.address.neighborhood}</p>
        <p>{site.address.city} / {site.address.state}</p>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="hover:text-sand-50 hover:underline">WhatsApp {site.phoneDisplay}</a>
        <a href={site.instagram} target="_blank" rel="noopener" class="hover:text-sand-50 hover:underline">{site.instagramHandle}</a>
      </div>
      <div class="flex flex-col gap-1.5 md:text-right">
        <p>Responsável técnica: {site.dentist}</p>
        <p>{site.cro}</p>
        <p class="mt-3">© {year} {site.name}</p>
      </div>
    </div>
  </div>
</footer>

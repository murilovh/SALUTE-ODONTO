---
// Logo da Salute em SVG inline (nítido em qualquer tamanho, sem fundo).
// variant: 'horizontal' (menu), 'stacked' (igual ao logo original) ou 'mark' (só o símbolo).
import { logoColors as c, logoPaths as p } from '../data/logo';

interface Props {
  variant?: 'horizontal' | 'stacked' | 'mark';
  class?: string;
  title?: string;
}

const { variant = 'horizontal', class: className, title = 'Salute Odontologia' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);

const viewBox = {
  mark: '31 29 81 40',
  stacked: '26 28 98 94',
  horizontal: '31 29 175 40',
}[variant];
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} class={className} role="img" aria-label={title}>
  <defs>
    <clipPath id={`arch-${uid}`}><path d={p.arch} /></clipPath>
  </defs>

  <!-- símbolo: arco, onda (mais escura onde passa sobre o arco) e escova -->
  <path d={p.arch} fill={c.teal} />
  <path d={p.wave} fill="none" stroke={c.wave} stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
  <path
    d={p.wave}
    fill="none"
    stroke={c.waveOnTeal}
    stroke-width="1.3"
    stroke-linecap="round"
    stroke-linejoin="round"
    clip-path={`url(#arch-${uid})`}
  />
  {p.bristles.map(([x, y, w, h]) => <rect x={x} y={y} width={w} height={h} fill={c.brush} />)}
  <rect x={p.handle[0]} y={p.handle[1]} width={p.handle[2]} height={p.handle[3]} fill={c.brush} />

  {
    variant === 'stacked' && (
      <>
        <path d={p.salute} fill={c.text} />
        <path d={p.odontoArc} fill={c.text} />
      </>
    )
  }

  {
    variant === 'horizontal' && (
      <>
        <path d={p.salute} fill={c.text} transform="translate(87.5 -41)" />
        <path d={p.odontoLine} fill={c.text} />
      </>
    )
  }
</svg>

---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '../data/site';
import heroImg from '../assets/fotos/hero-sorriso.jpg';

// Onda suave com período de 200 unidades, desenhada em 800 (2 telas). O SVG tem 200% de largura
// e desliza -50% em loop, então a emenda é invisível.
const wave = 'M 0 12 ' + Array.from({ length: 8 }, (_, i) => `Q ${i * 100 + 50} ${i % 2 ? 22 : 2}, ${(i + 1) * 100} 12`).join(' ');
---

<section id="topo" class="relative overflow-hidden pt-24 md:pt-28 lg:pt-24">
  <div class="container-page grid items-center gap-12 pb-16 md:pb-24 lg:min-h-[calc(100dvh-6rem)] lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7 lg:pr-6">
      <h1 data-split data-split-now class="text-display-xl">
        Cuidar do seu sorriso,<br class="hidden lg:inline" /> <em class="italic text-sea-700">perto do mar</em>.
      </h1>
      <p data-reveal class="mt-6 max-w-[34ch] text-lead text-ink-600">
        Odontologia com excelência, comprometimento e amor. Em Ibiraquera, pertinho da Praia do Rosa.
      </p>
      <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn-primary" data-hero-cta>
          <Icon name="MessageCircle" size={20} />
          Agendar avaliação
        </a>
        <a href={site.maps} target="_blank" rel="noopener" class="link-arrow">
          Como chegar
          <Icon name="ArrowUpRight" size={18} />
        </a>
      </div>
    </div>

    <div class="relative lg:col-span-5">
      <!-- foto em retângulo suave com um bloco verde-água deslocado atrás -->
      <div class="relative ml-auto w-[calc(100%-0.75rem)] max-w-[33rem] md:w-[calc(100%-1.75rem)]">
        <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-soft bg-sea-300 md:translate-x-7 md:translate-y-7" aria-hidden="true"></div>
        <div data-parallax="6" class="relative aspect-[4/5] overflow-hidden rounded-soft bg-sand-200">
          <Photo
            src={heroImg}
            alt="Paciente sorrindo com as mãos formando um coração em volta da boca"
            sizes="(min-width: 1024px) 33rem, 92vw"
            priority
            class="size-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="pointer-events-none overflow-hidden text-sea-500" aria-hidden="true">
    <svg class="wave-drift block h-6 w-[200%]" viewBox="0 0 800 24" preserveAspectRatio="none">
      <path d={wave} fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
    </svg>
  </div>
</section>

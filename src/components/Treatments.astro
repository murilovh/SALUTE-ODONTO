---
// Lista editorial: no desktop, passar o mouse (ou focar) em um grupo troca a foto ao lado.
import Photo from './Photo.astro';
import clinicaImg from '../assets/fotos/tratamento-clinica.jpg';
import esteticaImg from '../assets/fotos/tratamento-estetica.jpg';
import reabImg from '../assets/fotos/tratamento-reabilitacao.jpg';

// [CONFIRMAR] lista final de tratamentos com a Dra. Maria Eduarda
const groups = [
  {
    title: 'Clínica geral',
    text: 'O cuidado de rotina que mantém tudo em dia e evita surpresas.',
    items: ['Avaliação', 'Limpeza e profilaxia', 'Restaurações', 'Prevenção'],
    img: clinicaImg,
    alt: 'Dentista atendendo uma paciente deitada na cadeira, com calma e atenção',
  },
  {
    title: 'Estética',
    text: 'Ajustes que respeitam o seu rosto e deixam o sorriso com a sua cara.',
    items: ['Clareamento dental', 'Facetas e lentes de contato', 'Restaurações em resina', 'Fechamento de espaços'],
    img: esteticaImg,
    alt: 'Close de um sorriso com dentes claros e lábios vermelhos',
  },
  {
    title: 'Reabilitação',
    text: 'Devolver conforto e função para mastigar, falar e sorrir sem preocupação.',
    items: ['Coroas', 'Próteses', 'Reconstrução de dentes desgastados', 'Recuperação da mastigação'],
    img: reabImg,
    alt: 'Modelo de gesso de uma arcada dentária sobre a bancada do consultório',
  },
];
---

<section id="tratamentos" class="bg-sand-200/60 py-section" x-data="{ active: 0 }">
  <div class="container-page">
    <h2 data-split class="max-w-[16ch] text-display-lg">Tratamentos para cada fase do seu sorriso</h2>

    <div class="mt-14 grid gap-10 lg:mt-20 lg:grid-cols-12">
      <ol class="lg:col-span-7">
        {
          groups.map((g, i) => (
            <li
              data-reveal
              class="border-t border-sea-800/15 py-8 first:border-t-0 first:pt-0 lg:py-10"
              @mouseenter={`active = ${i}`}
              @focusin={`active = ${i}`}
            >
              <div class="mb-6 aspect-[16/10] overflow-hidden rounded-soft bg-sand-200 lg:hidden">
                <Photo src={g.img} alt={g.alt} sizes="92vw" class="size-full object-cover" />
              </div>
              <h3
                class="text-display-md transition-colors duration-500 ease-calm lg:text-sea-800/65"
                :class={`active === ${i} && 'lg:!text-sea-800'`}
              >
                {g.title}
              </h3>
              <p class="mt-3 max-w-[48ch] text-ink-600">{g.text}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <li class="rounded-full border border-sea-800/20 px-4 py-1.5 text-sm text-ink-900">{item}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>

      <div class="hidden lg:col-span-5 lg:block">
        <div class="sticky top-28 aspect-[4/5] overflow-hidden rounded-soft bg-sand-200">
          {
            groups.map((g, i) => (
              <div
                class:list={['absolute inset-0 transition-opacity duration-700 ease-calm', i === 0 ? 'opacity-100' : 'opacity-0']}
                :class={`active === ${i} ? 'opacity-100' : 'opacity-0'`}
                aria-hidden={i === 0 ? undefined : 'true'}
                :aria-hidden={`active !== ${i}`}
              >
                <Photo src={g.img} alt={g.alt} sizes="30rem" class="size-full object-cover" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
